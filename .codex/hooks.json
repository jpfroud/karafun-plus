{
  "description": "Rappelle le parcours gstack du projet sans bloquer le démarrage de Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/.codex/hooks/gstack-route.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/gstack-route.ps1')\"",
            "timeout": 5,
            "statusMessage": "Rappel du parcours gstack"
          }
        ]
      }
    ]
  }
}
