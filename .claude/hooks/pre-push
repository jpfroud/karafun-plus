#!/bin/sh
# Porte gstack karafun-plus : hook git pre-push, copié dans le dossier des
# hooks du dépôt par .claude/hooks/gstack-session-start.sh. Seuls les envois
# lancés par Claude Code (CLAUDECODE=1) sont contrôlés : le dernier commit
# envoyé sur chaque branche (le contenu envoyé) doit avoir le contenu exact
# d'une relecture gstack /review terminée.
[ "${CLAUDECODE:-}" = 1 ] || exit 0
[ "${GSTACK_GATE:-}" = off ] && exit 0
# Script de la porte : celui du worktree envoyé, sinon celui du dépôt principal
# (un vieux worktree peut ne pas l'avoir).
gate="$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/gstack-gate.js"
if [ ! -f "$gate" ]; then
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  gate="$(dirname "$common")/.claude/hooks/gstack-gate.js"
fi
if [ ! -f "$gate" ] || ! command -v node >/dev/null 2>&1; then
  echo "Porte gstack : envoi refusé, contrôle impossible (node ou $gate introuvable)." >&2
  exit 1
fi
exec node "$gate" pre-push "$@"
