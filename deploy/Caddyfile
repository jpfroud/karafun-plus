# Entrée HTTPS de karafun-plus, valeurs lues dans deploy/.env.
{
	email {$ACME_EMAIL}
	# Erreurs sans adresse ni en-têtes : ils portent la clé du bar et les accès.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

# Téléphones des clients (QR imprimés).
{$HOTE_CLIENTS} {
	reverse_proxy app:3001 {
		header_up X-Real-IP {remote_host}
		# Un téléphone ne peut pas se présenter comme l'entrée authentifiée du bar.
		header_up -X-Karaoke-Staff-Entry
		transport http {
			keepalive 50s
		}
	}
}

# Page du bar : mot de passe Caddy en plus de la clé du bar.
{$HOTE_BAR} {
	basic_auth {
		{$BAR_USER} {$BAR_PASSWORD_HASH}
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		# Remplacé après basic_auth ; seule l'application crée son lien avec clé.
		header_up X-Karaoke-Staff-Entry 1
		# Le mot de passe ne va pas à l'application.
		header_up -Authorization
		transport http {
			keepalive 50s
		}
	}
}
