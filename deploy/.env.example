# Réglages du VPS pour deploy/compose.yaml : copier en .env (chmod 600), remplir.
KARAFUN_PLUS_VERSION=vX.Y.Z

# Hôtes, chacun avec un enregistrement A vers l'IPv4 du VPS.
# HOTE_CLIENTS est l'hôte des QR imprimés : ne jamais le changer après impression.
HOTE_CLIENTS=clients.exemple.fr
HOTE_BAR=bar.exemple.fr
# Mêmes hôtes en origine HTTPS, sans / final.
KARAOKE_PUBLIC_URL=https://clients.exemple.fr
KARAOKE_STAFF_URL=https://bar.exemple.fr
# Contact Let's Encrypt.
ACME_EMAIL=<e-mail de l'administrateur>

# Mot de passe Caddy devant la page du bar, en plus de la clé du bar.
# Empreinte, mot de passe tapé au clavier (jamais en argument) :
#   docker run --rm -it caddy:2 caddy hash-password --bcrypt-cost 10
# Coût 10 : un mauvais mot de passe pour BAR_USER coûte environ 80 ms de
# calcul au serveur, au lieu d'une seconde au coût 14 par défaut. Un autre
# nom coûte toujours une seconde (empreinte factice de Caddy, au coût 14) :
# des essais répétés peuvent encore saturer le VPS.
# Garder les apostrophes : l'empreinte contient des « $ ».
BAR_USER=bar
BAR_PASSWORD_HASH='$2a$10$remplacer.par.l.empreinte.produite.par.caddy.hash.password'
