<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns="https://timefold.ai/xsd/solver"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://timefold.ai/xsd/solver https://timefold.ai/xsd/solver/solver.xsd">
  <solutionClass>fr.karafun.plus.solver.QueuePlan</solutionClass>
  <entityClass>fr.karafun.plus.solver.QueueLine</entityClass>
  <scoreDirectorFactory>
    <easyScoreCalculatorClass>fr.karafun.plus.solver.QueueScore</easyScoreCalculatorClass>
  </scoreDirectorFactory>
  <termination>
    <millisecondsSpentLimit>3000</millisecondsSpentLimit>
  </termination>
</solver>
